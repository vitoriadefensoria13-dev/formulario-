# Copie estas variáveis para o painel do Vercel (Project Settings > Environment
# Variables). NUNCA coloque valores reais neste arquivo nem faça commit dele
# com segredos preenchidos — ele existe só como modelo.

# JSON da service account do Google, em base64 (gere com:
# certutil -encode chave.json chave.b64   -- no Windows, ou
# base64 -w0 chave.json                    -- no Linux/Mac)
GOOGLE_SERVICE_ACCOUNT_KEY_BASE64=

# Pasta compartilhada no Drive onde as subpastas de cada cliente são criadas.
# Já vem preenchida com a pasta que a AFM indicou; troque só se mudar.
GOOGLE_DRIVE_PARENT_FOLDER_ID=1EY-Vsek-zQd48lHODIuWy61KdcYx4un3

# Domínio exato do site publicado (sem barra no final). Trava quem pode
# chamar essa função — deixar em branco ou "*" expõe o endpoint a qualquer site.
ALLOWED_ORIGIN=https://seu-dominio.vercel.app
